PORT=4000
MONGO_URI=mongodb://localhost:27017/shorts_cuter
STORAGE_DIR=./storage

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
YT_REDIRECT_URI=http://localhost:4000/api/auth/youtube/callback

# Optional: enables the ARQ worker instead of in-process background tasks
# REDIS_URL=redis://localhost:6379

# --- AI highlight selection -------------------------------------------------
# Without ANTHROPIC_API_KEY the pipeline falls back to the scene/silence scorer.
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-opus-5
# AI_EFFORT=high

# Whisper transcription (faster-whisper: tiny|base|small|medium|large-v3)
# WHISPER_MODEL=base
# WHISPER_DEVICE=auto
# WHISPER_LANGUAGE=en

# Twitch clip shape
# CLIP_MIN_SEC=5
# CLIP_MAX_SEC=60
